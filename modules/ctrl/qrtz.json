{
  "name": "ctrl",
  "version": "0.2.2",
  "kind": "extension",
  "description": "ctrl do: one command, carried out in the foreground through the accessibility tree; esc stops it.",
  "dependencies": {
    "model.laya": "^1.0.0"
  },
  "extension": {
    "entry": "bin/qrtz-ctrl",
    "protocol": 1,
    "minApp": "0.2.0",
    "channels": ["ctrl.*"],
    "views": ["ctrl"],
    "capabilities": ["ctrl.read", "ctrl.write", "module.settings"],
    "permissions": ["accessibility"],
    "settings": { "namespace": "ctrl", "legacySections": [] },
    "reads": ["model.laya"]
  }
}
