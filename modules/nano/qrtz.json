{
  "name": "nano",
  "version": "0.2.1",
  "kind": "extension",
  "description": "Meeting and voice notes: records, transcribes, diarizes and summarizes on this Mac.",
  "dependencies": {
    "model.localvqe": "^1.0.0",
    "model.nemotron": "^1.0.0",
    "model.nemotron-diarizer": "^1.0.0"
  },
  "extension": {
    "entry": "bin/qrtz-nano",
    "protocol": 1,
    "minApp": "0.2.0",
    "channels": [
      "recording.*",
      "meeting.*",
      "ax.*",
      "capture.*",
      "diarization.*",
      "summarize.*",
      "audio.*"
    ],
    "views": ["note"],
    "capabilities": [
      "note.read",
      "note.record",
      "note.write",
      "os.permissions",
      "speech.read",
      "module.settings"
    ],
    "permissions": ["microphone", "screen-recording", "accessibility"],
    "settings": {
      "namespace": "nano",
      "legacySections": ["note", "speech", "privacy"]
    },
    "reads": ["model.localvqe", "model.nemotron", "model.nemotron-diarizer"]
  }
}
