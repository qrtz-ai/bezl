{
  "name": "@qrtz/desktop",
  "productName": "qrtz",
  "version": "0.2.4",
  "private": true,
  "description": "qrtz desktop app (Tauri 2 + Rust core)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_QRTZ_MOCK_IPC=1 vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "start": "bun ../../scripts/build-helper.mjs && bun --bun run tauri:dev",
    "make": "bun ../../scripts/build-helper.mjs && bun --bun run tauri:build",
    "e2e": "playwright test -c ../../e2e-tauri/playwright.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@qrtz/core": "workspace:*",
    "@qrtz/feature-ctrl": "workspace:*",
    "@qrtz/feature-snap": "workspace:*",
    "@qrtz/feature-dash": "workspace:*",
    "@qrtz/feature-gallery": "workspace:*",
    "@qrtz/feature-marketplace": "workspace:*",
    "@qrtz/feature-note": "workspace:*",
    "@qrtz/feature-settings": "workspace:*",
    "@qrtz/feature-talk": "workspace:*",
    "@qrtz/ui": "workspace:*",
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
