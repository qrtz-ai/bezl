{
  "name": "@qrtz/desktop",
  "productName": "qrtz",
  "version": "0.4.4",
  "private": true,
  "description": "qrtz desktop app (Tauri 2 + Rust core)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_QRTZ_MOCK_IPC=1 vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "start": "bun ../../scripts/build-helper.mjs && bash ../../scripts/dev/dev-local.sh",
    "make": "bun ../../scripts/build-helper.mjs && bun --bun run tauri:build",
    "e2e": "bun run build-storybook && bun run screenshots && playwright test -c ../../e2e-tauri/playwright.config.ts",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6106",
    "build-storybook": "storybook build -o storybook-static && bun .storybook/strip-fonts.mjs",
    "screenshots": "playwright test -c screenshots/playwright.config.ts",
    "screenshots:update": "playwright test -c screenshots/playwright.config.ts --update-snapshots=all"
  },
  "dependencies": {
    "@qrtz/core": "workspace:*",
    "@qrtz/feature-ctrl": "workspace:*",
    "@qrtz/feature-snap": "workspace:*",
    "@qrtz/feature-dash": "workspace:*",
    "@qrtz/feature-marketplace": "workspace:*",
    "@qrtz/feature-note": "workspace:*",
    "@qrtz/feature-settings": "workspace:*",
    "@qrtz/feature-talk": "workspace:*",
    "@qrtz/ui": "workspace:*",
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "vite": "^8.3.4",
    "@storybook/react-vite": "^10.6.2",
    "storybook": "^10.6.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
