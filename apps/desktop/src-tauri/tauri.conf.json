{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qrtz",
  "mainBinaryName": "qrtz-app",
  "version": "0.4.4",
  "identifier": "ai.qrtz.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun --bun run dev",
    "beforeBuildCommand": "bun --bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' qrtz-media: http://qrtz-media.localhost; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb"],
    "category": "Productivity",
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../licenses/AGPL-3.0.txt": "licenses/AGPL-3.0.txt",
      "../../../LICENSE-EXCEPTION.md": "licenses/LICENSE-EXCEPTION.md",
      "../../../licenses/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../../../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "entitlements.mac.plist",
      "infoPlist": "Info.plist"
    }
  }
}
