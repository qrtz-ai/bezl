{
  "name": "qrtz-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/features/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run start -w @qrtz/desktop",
    "package": "npm run package -w @qrtz/desktop",
    "make": "npm run make -w @qrtz/desktop",
    "lint": "oxlint && oxfmt --check && node scripts/check-boundaries.mjs",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3"
  }
}
