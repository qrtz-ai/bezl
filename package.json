{
  "name": "qrtz-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/features/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run start -w @qrtz/desktop",
    "package": "npm run package -w @qrtz/desktop",
    "make": "npm run make -w @qrtz/desktop",
    "lint": "oxlint && oxfmt --check && node scripts/check-boundaries.mjs && node scripts/check-swift.mjs",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build:helper": "node scripts/build-helper.mjs",
    "test:helper": "node scripts/build-helper.mjs --test",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
