{
  "about": "Cloud/on-device arbitration (packages/core/src/talk/asr.ts EngineArbiter ⇄ crates/qrtz-talk/src/arbiter.rs). Steps run in order at time `at` (ms); `finish` is the flush after dictation.stopped: cloud {ok} | {err} | null when the cloud is not in use. TS is the oracle: QRTZ_VECTORS_UPDATE=1 npx vitest run engine-arbiter.vectors.",
  "cases": [
    {
      "name": "on-device only",
      "stallMs": 1500,
      "steps": [
        {
          "op": "localPartial",
          "text": "hello",
          "at": 100,
          "expect": {
            "usingCloud": false,
            "engine": "on-device",
            "view": [
              "",
              "hello"
            ]
          }
        },
        {
          "op": "localFinal",
          "text": "hello there",
          "at": 300,
          "expect": {
            "usingCloud": false,
            "engine": "on-device",
            "view": [
              "hello there",
              ""
            ]
          }
        },
        {
          "op": "localPartial",
          "text": "how",
          "at": 400,
          "expect": {
            "usingCloud": false,
            "engine": "on-device",
            "view": [
              "hello there",
              "how"
            ]
          }
        }
      ],
      "finish": {
        "local": "",
        "cloud": null
      },
      "expect": {
        "text": "hello there how",
        "engine": "on-device",
        "failover": false,
        "reason": null
      }
    },
