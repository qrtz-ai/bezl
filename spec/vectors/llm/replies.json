{
 "about": "OpenAI-compatible provider replies (llm.ts openAiCompatible/post): TS feeds them to a fake fetch, Rust (crates/qrtz-llm/tests/vectors.rs) serves them from a local mock HTTP server. `expect` is {ok: content} or {err: [code, retryable, message]}; parser-dependent text after 'LLM reply was not JSON: ' is replaced by '…' on both sides.",
 "cases": [
  {
   "name": "ok",
   "status": 200,
   "body": "{\"choices\": [{\"message\": {\"content\": \"{\\\"summary\\\":\\\"hi\\\"}\"}}]}",
   "expect": {
    "ok": "{\"summary\":\"hi\"}"
   }
  },
  {
   "name": "ok-extra-choices",
   "status": 200,
   "body": "{\"choices\": [{\"message\": {\"content\": \"first\"}}, {\"message\": {\"content\": \"second\"}}]}",
   "expect": {
    "ok": "first"
   }
  },
  {
   "name": "no-content",
   "status": 200,
   "body": "{\"choices\": [{\"message\": {}}]}",
   "expect": {
    "ok": ""
   }
  },
  {
   "name": "empty-choices-no-error",
   "status": 200,
   "body": "{\"choices\": []}",
   "expect": {
    "ok": ""
   }
  },
  {
   "name": "null-body",
   "status": 200,
   "body": "null",
   "expect": {
    "ok": ""
   }
  },
  {
   "name": "error-in-200-502",
   "status": 200,
   "body": "{\"error\": {\"message\": \"upstream overloaded\", \"code\": 502}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM error: upstream overloaded"
    ]
   }
  },
  {
   "name": "error-in-200-400",
   "status": 200,
   "body": "{\"error\": {\"message\": \"bad request: context too long\", \"code\": 400}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM error: bad request: context too long"
    ]
   }
  },
  {
   "name": "error-in-200-429",
   "status": 200,
   "body": "{\"error\": {\"message\": \"slow down\", \"code\": 429}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM error: slow down"
    ]
   }
  },
  {
   "name": "error-in-200-string",
   "status": 200,
   "body": "{\"error\": \"boom\"}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM error: boom"
    ]
   }
  },
  {
   "name": "error-in-200-no-message",
   "status": 200,
   "body": "{\"error\": {\"code\": \"x\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM error: provider error"
    ]
   }
  },
  {
   "name": "error-null",
   "status": 200,
   "body": "{\"error\": null}",
   "expect": {
    "ok": ""
   }
  },
  {
   "name": "error-with-choices",
   "status": 200,
   "body": "{\"error\": {\"message\": \"ignored\"}, \"choices\": [{\"message\": {\"content\": \"c\"}}]}",
   "expect": {
    "ok": "c"
   }
  },
  {
   "name": "html-200",
   "status": 200,
   "body": "<html><body>Captive portal</body></html>",
   "contentType": "text/html",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM reply was not JSON: …"
    ]
   }
  },
  {
   "name": "empty-200",
   "status": 200,
   "body": "",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM reply was not JSON: …"
    ]
   }
  },
  {
   "name": "http-401",
   "status": 401,
   "body": "{\"error\": {\"message\": \"No auth credentials found\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM HTTP 401: No auth credentials found (check the API key in Settings)"
    ]
   }
  },
  {
   "name": "http-403-plain",
   "status": 403,
   "body": "Forbidden",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM HTTP 403: Forbidden (check the API key in Settings)"
    ]
   }
  },
  {
   "name": "http-402",
   "status": 402,
   "body": "{\"error\": {\"message\": \"Insufficient credits\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM HTTP 402: Insufficient credits (no OpenRouter credits: add credits at openrouter.ai/settings/credits, then retry)"
    ]
   }
  },
  {
   "name": "http-429",
   "status": 429,
   "body": "{\"error\": {\"message\": \"rate limited\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM HTTP 429: rate limited (rate limited; try again shortly)"
    ]
   }
  },
  {
   "name": "http-500-long",
   "status": 500,
   "body": "",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM HTTP 500: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    ]
   }
  },
  {
   "name": "http-503-long-message",
   "status": 503,
   "body": "{\"error\": {\"message\": \"\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     true,
     "LLM HTTP 503: mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"
    ]
   }
  },
  {
   "name": "http-404-string-error",
   "status": 404,
   "body": "{\"error\": \"model not found\"}",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM HTTP 404: model not found"
    ]
   }
  },
  {
   "name": "http-400-empty-message",
   "status": 400,
   "body": "{\"error\": {\"message\": \"\"}}",
   "expect": {
    "err": [
     "E_PROVIDER",
     false,
     "LLM HTTP 400: {\"error\": {\"message\": \"\"}}"
    ]
   }
  }
 ]
}
