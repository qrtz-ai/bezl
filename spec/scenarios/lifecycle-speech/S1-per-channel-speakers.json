{
  "name": "S1-per-channel-speakers",
  "about": "ADR 0058 \u00a712 (Rust only). Mic and system audio are diarized apart: each channel has its own speaker ids (mic:0.., system:0..). At finalize every line takes its own channel's speaker with the most overlap. The mic's main voice is \"me\" by default (renameable); a second voice on the same mic is its own speaker, never folded into \"me\"; a mic line no mic turn covers gets no speaker. Other speakers are \"speaker n\" in order of first appearance. Turns of one voice that follow each other merge; a turn on a channel the session doesn't have is dropped (N68).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "speech",
      "audioPath": "$REC/id1.wav",
      "event": {
        "type": "speaker",
        "speaker": "system:0",
        "startMs": 0,
        "endMs": 800
      }
    },
    {
