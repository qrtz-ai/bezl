{
  "name": "H8-fallback-no-source",
  "about": "H8: capture.fallback to:null degrades audio-unavailable at once; the error{audio.unavailable} that follows is a no-op; recording.started still follows and the recording runs (AX, notes) with the fallbacks on the pipeline.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.fallback",
        "from": "core-audio-tap",
        "to": "screencapturekit",
        "reason": "tap creation failed"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.fallback",
        "from": "screencapturekit",
        "to": null,
        "reason": "screen recording denied"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "error",
        "code": "audio.unavailable",
        "message": "no audio source could start",
        "fatal": false
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "system",
        "sinceMs": 0
      }
    },
    {
      "op": "snapshot",
      "label": "recording"
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "starting|id1|audio-unavailable|-|-|-|ok",
        "recording|id1|audio-unavailable|-|-|-|ok",
        "stopping|id1|audio-unavailable|-|-|-|ok",
        "processing|id1|audio-unavailable|-|-|-|ok",
        "done|id1|audio-unavailable|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:running/1 summary:pending/0 index:pending/0 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:done/1 summary:pending/0 index:pending/0 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:done/1 summary:running/1 index:pending/0 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:done/1 summary:done/1 index:pending/0 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:done/1 summary:done/1 index:running/1 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]",
          "manual finalize:done/1 summary:done/1 index:done/1 [fb:core-audio-tap>screencapturekit@0 fb:screencapturekit>-@0 lost:system:0-1000 lost:mic:0-1000]"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
