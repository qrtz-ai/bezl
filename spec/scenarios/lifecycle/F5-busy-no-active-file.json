{
  "name": "F5-busy-no-active-file",
  "about": "F5 watchdog (file rule broken): the helper answers recording.start with error recording.busy{audioPath} naming no activeAudioPath, i.e. it claims a recording runs without a file. Last resort, logged as a bug: the start fails (E_UNAVAILABLE, helper-busy), no stop is sent (never a pathless stop), the helper is restarted, and the retry starts.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "T"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "error",
        "code": "recording.busy",
        "message": "a recording is already running",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "refused"
    },
    {
      "op": "advance",
      "ms": 5000
    },
    {
      "op": "call",
      "fn": "start",
      "label": "again",
      "args": {
        "title": "Again"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id2.wav"
      }
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id2.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "idle|-|-|helper-busy|-|-|ok",
        "starting|id2|-|-|-|-|ok",
        "recording|id2|-|-|-|-|ok",
        "stopping|id2|-|-|-|-|ok",
        "processing|id2|-|-|-|-|ok",
        "done|id2|-|-|-|-|ok"
      ],
      "pipelines": {
        "id2": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:running/1",
          "manual finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "restart",
        "recording.start $REC/id2.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
