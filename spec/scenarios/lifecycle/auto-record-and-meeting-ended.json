{
  "name": "auto-record-and-meeting-ended",
  "about": "Auto-record: a detected meeting starts recording with its title; meeting.ended for that key stops it.",
  "config": {
    "autoRecord": true
  },
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "meeting.detected",
        "key": "zoom:1",
        "title": "Weekly sync",
        "platform": "zoom",
        "app": "zoom.us"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "recording"
    },
    {
      "op": "helper",
      "msg": {
        "type": "meeting.ended",
        "key": "zoom:2"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "meeting.ended",
        "key": "zoom:1"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 3000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "detected|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "meeting-ended finalize:pending/0 summary:pending/0 index:pending/0",
          "meeting-ended finalize:running/1 summary:pending/0 index:pending/0",
          "meeting-ended finalize:done/1 summary:pending/0 index:pending/0",
          "meeting-ended finalize:done/1 summary:running/1 index:pending/0",
          "meeting-ended finalize:done/1 summary:done/1 index:pending/0",
          "meeting-ended finalize:done/1 summary:done/1 index:running/1",
          "meeting-ended finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {},
    "snapshots": {
      "recording": {
        "view": {
          "phase": "recording",
          "meetingId": "id1",
          "startedAt": 1760000000000,
          "elapsedMs": 0,
          "stopReason": null,
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": null
        },
        "live": {
          "meetingId": "id1",
          "rev": 0,
          "segments": [],
          "partial": null
        },
        "db": {
          "meetings": [
            [
              "id1",
              "Weekly sync",
              "zoom",
              "recording",
              1760000000000,
              null,
              null,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [],
          "notes": [],
          "pipelines": [],
          "session": [
            "recording",
            "id1"
          ]
        },
        "files": []
      },
      "end": {
        "view": {
          "phase": "done",
          "meetingId": "id1",
          "startedAt": 1760000000000,
          "elapsedMs": 0,
          "stopReason": "meeting-ended",
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": "finalize:done/1 summary:done/1 index:done/1"
        },
        "live": {
          "meetingId": "id1",
          "rev": 1,
          "segments": [],
          "partial": null
        },
        "db": {
          "meetings": [
            [
              "id1",
              "Weekly sync",
              "zoom",
              "done",
              1760000000000,
              1760000000000,
              3000,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [
            [
              "id1",
              "stub",
              "STUB summary",
              null
            ]
          ],
          "notes": [],
          "pipelines": [
            [
              "id1",
              1,
              "meeting-ended",
              "finalize:done/1 summary:done/1 index:done/1",
              3000,
              false,
              [
                "$REC/id1.wav"
              ],
              0
            ]
          ],
          "session": [
            "done",
            "id1"
          ]
        },
        "files": []
      }
    }
  }
}
