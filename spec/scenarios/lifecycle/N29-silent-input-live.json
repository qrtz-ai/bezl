{
  "name": "N29-silent-input-live",
  "about": "N29: capture.silent / capture.audible per source on a live recording. Audible without a prior silent and a duplicate silent are ignored; mic then system silent is 'no audio at all' (noAudio) until system is audible again; a stop while the mic is still silent closes its stretch at the stop; the spans reach the meeting's pipeline.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.audible",
        "source": "mic"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "mic",
        "sinceMs": 0
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "mic",
        "sinceMs": 0
      }
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "system",
        "sinceMs": 1000
      }
    },
    {
      "op": "snapshot",
      "label": "no-audio"
    },
    {
      "op": "advance",
      "ms": 5000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.audible",
        "source": "system"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.audible",
        "source": "system"
      }
    },
    {
      "op": "snapshot",
      "label": "mic-silent"
    },
    {
      "op": "advance",
      "ms": 4000
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 70000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 70000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "snapshot",
      "label": "done"
    },
    {
      "op": "call",
      "fn": "pipeline",
      "label": "pipe",
      "args": {
        "id": "id1"
      }
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok|s:mic@0",
        "recording|id1|-|-|-|-|ok|s:mic@0,system@1000!",
        "recording|id1|-|-|-|-|ok|s:mic@0",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0 [system:1000-66000 mic:0-70000]",
          "manual finalize:running/1 summary:pending/0 index:pending/0 [system:1000-66000 mic:0-70000]",
          "manual finalize:done/1 summary:pending/0 index:pending/0 [system:1000-66000 mic:0-70000]",
          "manual finalize:done/1 summary:running/1 index:pending/0 [system:1000-66000 mic:0-70000]",
          "manual finalize:done/1 summary:done/1 index:pending/0 [system:1000-66000 mic:0-70000]",
          "manual finalize:done/1 summary:done/1 index:running/1 [system:1000-66000 mic:0-70000]",
          "manual finalize:done/1 summary:done/1 index:done/1 [system:1000-66000 mic:0-70000]"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
