{
  "name": "F3-helper-crash-reconnect",
  "about": "F3: the helper dies mid-recording, comes back within the window, resumes into part 1 (ids namespaced, offset applied, transcript-gap); finalize stitches both parts.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 0,
        "name": "Ana"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "partial",
          "utteranceId": "u1",
          "startMs": 100,
          "text": "hello"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 2000,
        "name": "Ben"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u2",
          "startMs": 2100,
          "endMs": 3900,
          "text": "thanks ana"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 3000,
      "broken": true
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "snapshot",
      "label": "reconnecting"
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.p1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 0,
          "endMs": 900,
          "text": "after the gap"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "snapshot",
      "label": "resumed"
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 1000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
