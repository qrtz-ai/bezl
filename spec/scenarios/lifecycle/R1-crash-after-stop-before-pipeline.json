          "crash-recovered finalize:done/1 summary:running/1 index:pending/0",
          "crash-recovered finalize:done/1 summary:done/1 index:pending/0",
          "crash-recovered finalize:done/1 summary:done/1 index:running/1",
          "crash-recovered finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
