{
  "name": "R1-crash-after-stop-before-pipeline",
  "about": "R1 kill point: the session was saved stopping and the stop never completed; a second restart is idempotent.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "restart"
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "restart"
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
