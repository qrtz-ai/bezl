{
  "name": "N35-revoke-then-device-takeover",
  "about": "N35: the mic device fails, then the mic permission is revoked: the revoke takes the flag over, so it outlives the reconnect (the device-only flag would not).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "advance",
      "ms": 500
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.degraded",
        "degraded": [
          "no-mic"
        ],
        "reason": "mic unavailable, recording system audio only: device busy"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permission.revoked",
        "permission": "microphone",
        "atMs": 800,
        "degraded": [
          "no-mic"
        ]
      }
    },
    {
      "op": "advance",
      "ms": 500
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 1000,
      "broken": true
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.p1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "restored"
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 1000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "recording|id1|no-mic|-|-|-|ok|d:no-mic",
        "recording|id1|no-mic|-|-|-|ok",
        "reconnecting|id1|no-mic|-|r1|-|ok",
        "recording|id1|no-mic,transcript-gap|-|-|-|ok",
        "stopping|id1|no-mic,transcript-gap|-|-|-|ok",
        "processing|id1|no-mic,transcript-gap|-|-|-|ok",
        "done|id1|no-mic,transcript-gap|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0 [dev:no-mic@500]",
          "manual finalize:running/1 summary:pending/0 index:pending/0 [dev:no-mic@500]",
          "manual finalize:done/1 summary:pending/0 index:pending/0 [dev:no-mic@500]",
          "manual finalize:done/1 summary:running/1 index:pending/0 [dev:no-mic@500]",
          "manual finalize:done/1 summary:done/1 index:pending/0 [dev:no-mic@500]",
          "manual finalize:done/1 summary:done/1 index:running/1 [dev:no-mic@500]",
          "manual finalize:done/1 summary:done/1 index:done/1 [dev:no-mic@500]"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "permissions.check",
        "recording.start $REC/id1.p1.wav",
        "recording.stop"
      ],
      "transcript": [
