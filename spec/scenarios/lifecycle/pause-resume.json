{
  "name": "pause-resume",
  "about": "Privacy pause drops ASR while paused; resume; pause is re-applied after a helper restart; pause outside recording is rejected.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "pause",
      "label": "pause-idle"
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 0,
          "endMs": 500,
          "text": "before"
        }
      }
    },
    {
      "op": "call",
      "fn": "pause",
      "label": "pause"
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u2",
          "startMs": 600,
          "endMs": 900,
          "text": "secret"
        }
      }
    },
    {
      "op": "snapshot",
      "label": "paused"
    },
    {
      "op": "helperDown"
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.p1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "resumed-paused"
    },
    {
      "op": "call",
      "fn": "pause",
      "label": "resume",
      "args": {
        "want": false
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u3",
          "startMs": 0,
          "endMs": 500,
          "text": "after"
        }
      }
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 500
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
