{
  "name": "racing-starts-and-double-stop",
  "about": "Two starts racing: the second is refused (already starting); a second stop is a no-op; start while recording is refused.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "a",
      "args": {
        "title": "A"
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "b",
      "args": {
        "title": "B"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "c",
      "args": {
        "title": "C"
      }
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "s1"
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "s2"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "s3"
    }
  ],
  "expect": {
