{
  "name": "F5-helper-missing",
  "about": "Recording is unavailable when the helper is missing from the build.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "helperHealth",
      "health": "missing",
      "detail": "not bundled"
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "T"
      }
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "idle|-|-|-|-|-|missing"
      ],
      "pipelines": {},
      "helper": [
        "permissions.check"
      ],
      "transcript": [],
      "changed": [],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "start": {
        "err": [
          "E_UNAVAILABLE",
          "Recording is unavailable: the native capture helper is missing from this build."
        ]
      }
    },
    "snapshots": {
      "end": {
        "view": {
          "phase": "idle",
          "meetingId": null,
          "startedAt": null,
          "elapsedMs": 0,
          "stopReason": null,
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "missing",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": null
        },
        "live": null,
        "db": {
          "meetings": [],
          "segments": [],
          "summaries": [],
          "notes": [],
          "pipelines": [],
          "session": null
        },
        "files": []
      }
    }
  }
}
