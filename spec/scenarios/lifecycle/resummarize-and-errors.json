{
  "name": "resummarize-and-errors",
  "about": "resummarize after finalize routes through the pipeline; retryStep on an unknown meeting is E_NOT_FOUND; addNote with nothing recording is E_VALIDATION.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "addNote",
      "label": "note-none",
      "args": {
        "text": "x"
      }
    },
    {
      "op": "call",
      "fn": "retryStep",
      "label": "unknown",
      "args": {
        "id": "nope",
        "step": "summary"
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "call",
      "fn": "resummarize",
      "label": "resum",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 200
    },
    {
      "op": "call",
      "fn": "addNote",
      "label": "note-past",
      "args": {
        "meetingId": "id1",
        "text": "later",
        "atMs": 1234.6
      }
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:running/1",
          "manual finalize:done/1 summary:done/1 index:done/1",
          "manual finalize:done/1 summary:pending/0 index:done/1",
          "manual finalize:done/1 summary:running/1 index:done/1",
          "manual finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "note-none": {
        "err": [
          "E_VALIDATION",
          "no meeting is being recorded"
        ]
      },
      "unknown": {
        "err": [
          "E_NOT_FOUND",
          "no post-processing record for nope"
        ]
      },
      "start": {
        "ok": {
          "phase": "recording",
          "meetingId": "id1"
        }
      },
      "stop": {
        "ok": {
          "phase": "processing",
          "meetingId": "id1"
        }
      },
      "resum": {
        "ok": "STUB summary"
      },
      "note-past": {
        "ok": [
          "id2",
          "id1",
          1235,
          "later"
        ]
      }
    },
    "snapshots": {
      "end": {
        "view": {
          "phase": "done",
          "meetingId": "id1",
          "startedAt": 1760000000000,
          "elapsedMs": 0,
          "stopReason": "manual",
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": "finalize:done/1 summary:done/1 index:done/1"
        },
        "live": {
          "meetingId": "id1",
          "rev": 1,
          "segments": [],
          "partial": null
        },
        "db": {
          "meetings": [
            [
              "id1",
              "Standup",
              "other",
              "done",
              1760000000000,
              1760000000000,
              4000,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [
            [
              "id1",
              "stub",
              "STUB summary",
              null
            ]
          ],
          "notes": [
            [
              "id2",
              "id1",
              1235,
              "later"
            ]
          ],
          "pipelines": [
            [
              "id1",
              1,
              "manual",
              "finalize:done/1 summary:done/1 index:done/1",
              4000,
              false,
              [
                "$REC/id1.wav"
              ],
              0
            ]
          ],
          "session": [
            "done",
            "id1"
          ]
        },
        "files": []
      }
    }
  }
}
