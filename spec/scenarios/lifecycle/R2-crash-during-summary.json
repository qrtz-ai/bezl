{
  "name": "R2-crash-during-summary",
  "about": "R2: the app dies with the summary running (and again in its backoff): finalize is not repeated.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
