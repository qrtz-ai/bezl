        "type": "asr",
        "event": {
          "kind": "partial",
          "utteranceId": "u1",
          "startMs": 100,
          "text": "hello"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
