    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "restart"
    },
    {
      "op": "snapshot",
      "label": "retry"
    },
    {
      "op": "restart"
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "snapshot",
      "label": "backoff"
    },
    {
      "op": "advance",
      "ms": 4000
    }
