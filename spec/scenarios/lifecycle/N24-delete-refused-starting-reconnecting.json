{
  "name": "N24-delete-refused-starting-reconnecting",
  "about": "Cycle 5, extends N24-delete-while-recording (which covers recording and stopping): the delete is also refused while the meeting is starting and while it is reconnecting after a helper crash, and the refusal changes nothing: the reconnect part is still written, stitched and later removed with the meeting. Deleting a different, finished meeting while recording still works.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-starting",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
      }
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 2000,
      "broken": true
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-recording",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "db",
      "seedMeeting": {
        "id": "old1",
        "title": "Last week",
        "platform": "zoom",
        "startedAt": 1759990000000,
        "endedAt": 1759990060000,
        "status": "done",
        "participants": [],
        "durationMs": 60000,
        "audioPath": "$REC/old1.wav"
      }
    },
    {
      "op": "wav",
      "file": "old1.wav",
      "ms": 100,
      "broken": false
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-other-while-recording",
      "args": {
        "id": "old1"
      }
    },
    {
      "op": "advance",
      "ms": 50
    },
    {
      "op": "snapshot",
      "label": "after-refused-delete"
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-reconnecting",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 500
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.p1.wav"
      }
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 500,
      "broken": false
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 0,
          "endMs": 400,
          "text": "after the gap"
        }
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-stopping",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 500
      }
    },
    {
      "op": "advance",
      "ms": 200
    },
    {
      "op": "snapshot",
      "label": "done"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete-done",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 50
    }
  ],
