{
  "name": "N27-deleted-mid-step",
  "about": "Cycle 5 N27: the meeting is deleted while its summary step is in flight (a slow provider that then fails). When the step returns, the host finds no pipeline and stops there: no retry, no fallback, no pipeline event and no save for the deleted meeting. Before the fix the TS host dereferenced the forgotten pipeline (a TypeError, an unhandled rejection in Electron main) and the Rust host fell back to its stale copy, re-inserted it and emitted a pipeline event for the deleted meeting before the store refused the save.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "steps",
      "summary": [
        "slow-fail"
      ]
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
