        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
      }
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 400,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 2000
      }
    },
    {
      "op": "advance",
      "ms": 50
    },
    {
      "op": "snapshot",
      "label": "summary-in-flight"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 50
    },
    {
      "op": "snapshot",
      "label": "deleted"
    },
    {
      "op": "advance",
      "ms": 10000
    }
  ],
