{
  "name": "N16-deleted-mid-backoff",
  "about": "Cycle 4 N16 + N14: the user deletes the meeting while its summary waits out a backoff. The host forgets the pipeline at once: the retry timer never fires a step for a meeting that no longer exists, nothing is written back, and the session lets go of the deleted meeting (idle).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "steps",
      "summary": [
        "fail",
        "ok"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "snapshot",
      "label": "retrying"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 2500
    },
    {
      "op": "call",
      "fn": "pipeline",
      "label": "after",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 50
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok",
        "idle|-|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:retrying/1!E_UNAVAILABLE index:pending/0"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "start": {
        "ok": {
          "phase": "recording",
          "meetingId": "id1"
        }
      },
      "stop": {
        "ok": {
          "phase": "processing",
          "meetingId": "id1"
        }
      },
      "delete": {
        "ok": [
          "id1.wav"
        ]
      },
      "after": {
