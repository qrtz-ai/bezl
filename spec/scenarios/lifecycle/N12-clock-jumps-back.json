{
  "name": "N12-clock-jumps-back",
  "about": "Cycle 3 N12: the summary fails once and waits out its backoff; meanwhile the wall clock jumps back an hour (NTP, VM resume, manual change). The retry still runs when its timer fires instead of re-waiting on the wall-clock nextRetryAt (which would stall the step for the size of the jump).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "steps",
      "summary": [
        "fail",
        "ok"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "snapshot",
      "label": "retrying"
    },
    {
      "op": "clockJump",
      "ms": -3600000
    },
    {
      "op": "advance",
      "ms": 2500
    },
    {
      "op": "snapshot",
      "label": "after-backoff"
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:retrying/1!E_UNAVAILABLE index:pending/0",
          "manual finalize:done/1 summary:running/2!E_UNAVAILABLE index:pending/0",
          "manual finalize:done/1 summary:done/2 index:pending/0",
          "manual finalize:done/1 summary:done/2 index:running/1",
          "manual finalize:done/1 summary:done/2 index:done/1"
        ]
      },
      "helper": [
