{
  "name": "N43-speaker-clock-before-ack",
  "about": "N43: an AX speaker change is placed in meeting time only once its part's ack is applied. Before the ack (starting) and while reconnecting, the helper's atMs counts from its own start, so those are ignored; one in the ack's own chunk is held and gets the new part's offset (N37 hold). Ana names the first line, Ben the line after the reconnect; Old and Zed name nothing.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 5000000,
        "name": "Old"
      }
    },
    {
      "op": "helperBatch",
      "msgs": [
        {
          "type": "recording.started",
          "audioPath": "$REC/id1.wav"
        },
        {
          "type": "ax.activeSpeaker",
          "atMs": 0,
          "name": "Ana"
        },
        {
          "type": "asr",
          "event": {
            "kind": "final",
            "utteranceId": "u1",
            "startMs": 100,
            "endMs": 1900,
            "text": "hello everyone"
          }
        }
      ]
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 2000,
      "broken": true
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 300,
        "name": "Zed"
      }
    },
    {
      "op": "helperBatch",
      "msgs": [
        {
          "type": "recording.started",
          "audioPath": "$REC/id1.p1.wav"
        },
        {
          "type": "ax.activeSpeaker",
          "atMs": 0,
          "name": "Ben"
        },
        {
          "type": "asr",
          "event": {
            "kind": "final",
            "utteranceId": "u1",
            "startMs": 100,
            "endMs": 900,
            "text": "after the gap"
          }
        }
      ]
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 1000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
