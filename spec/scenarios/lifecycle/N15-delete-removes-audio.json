{
  "name": "N15-delete-removes-audio",
  "about": "Cycle 4 N15: deleting a finished meeting removes its recording and any leftover <id>.p<n>.wav part from the recordings directory, never another meeting's file. Before the fix the rows went and the audio stayed on disk forever (retention only walks existing meetings).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 400,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 100,
      "broken": false
    },
    {
      "op": "wav",
      "file": "other.wav",
      "ms": 100,
      "broken": false
    },
    {
      "op": "advance",
      "ms": 200
    },
    {
      "op": "snapshot",
      "label": "done"
    },
    {
      "op": "call",
      "fn": "deleteMeeting",
      "label": "delete",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 50
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok",
        "idle|-|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:running/1",
          "manual finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "start": {
        "ok": {
          "phase": "recording",
          "meetingId": "id1"
        }
      },
      "stop": {
        "ok": {
          "phase": "processing",
          "meetingId": "id1"
        }
      },
      "delete": {
        "ok": [
          "id1.p1.wav",
          "id1.wav"
        ]
      }
    },
    "snapshots": {
      "done": {
        "view": {
          "phase": "done",
          "meetingId": "id1",
          "startedAt": 1760000000000,
          "elapsedMs": 0,
          "stopReason": "manual",
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": "finalize:done/1 summary:done/1 index:done/1"
        },
        "live": {
          "meetingId": "id1",
          "rev": 1,
          "segments": [],
          "partial": null
        },
        "db": {
          "meetings": [
            [
              "id1",
              "Standup",
              "other",
              "done",
              1760000000000,
              1760000000000,
              4000,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [
            [
              "id1",
              "stub",
              "STUB summary",
              null
            ]
          ],
          "notes": [],
          "pipelines": [
            [
              "id1",
              1,
              "manual",
              "finalize:done/1 summary:done/1 index:done/1",
              4000,
              false,
              [
                "$REC/id1.wav"
              ],
              0
            ]
          ],
          "session": [
            "done",
            "id1"
          ]
        },
        "files": [
          [
            "id1.p1.wav",
            3244
