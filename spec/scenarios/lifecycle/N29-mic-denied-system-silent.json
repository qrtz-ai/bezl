{
  "name": "N29-mic-denied-system-silent",
  "about": "N29: a recording started with the microphone denied carries no flag for it, so system silence alone is 'no audio at all' (the view counts denied sources as not delivered).",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "denied"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "system",
        "sinceMs": 0
      }
    },
    {
      "op": "snapshot",
      "label": "silent"
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok|s:system@0!",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0 [system:0-1000]",
          "manual finalize:running/1 summary:pending/0 index:pending/0 [system:0-1000]",
          "manual finalize:done/1 summary:pending/0 index:pending/0 [system:0-1000]",
          "manual finalize:done/1 summary:running/1 index:pending/0 [system:0-1000]",
          "manual finalize:done/1 summary:done/1 index:pending/0 [system:0-1000]",
          "manual finalize:done/1 summary:done/1 index:running/1 [system:0-1000]",
          "manual finalize:done/1 summary:done/1 index:done/1 [system:0-1000]"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
