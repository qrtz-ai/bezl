{
  "name": "H7-clock-jump-during-reconnect",
  "about": "H7 + clock skew: the wall clock jumps forward an hour while the helper is down. The second part's offset (and its transcript) move an hour on, but the pad written before it is capped at the reconnect window plus the start ack (35 s), so the stitched file stays small.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "clockJump",
      "ms": 3600000
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.p1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 0,
          "endMs": 800,
          "text": "after the jump"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 2000,
      "broken": true
    },
    {
      "op": "wav",
      "file": "id1.p1.wav",
      "ms": 1000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.p1.wav",
        "durationMs": 1000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "reconnecting|id1|-|-|r1|-|ok",
        "recording|id1|transcript-gap|-|-|-|ok",
        "stopping|id1|transcript-gap|-|-|-|ok",
        "processing|id1|transcript-gap|-|-|-|ok",
        "done|id1|transcript-gap|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:pending/0",
          "manual finalize:done/1 summary:done/1 index:running/1",
          "manual finalize:done/1 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "permissions.check",
        "recording.start $REC/id1.p1.wav",
        "recording.stop"
      ],
      "transcript": [
