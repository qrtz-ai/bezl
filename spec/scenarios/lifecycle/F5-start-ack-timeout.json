{
  "name": "F5-start-ack-timeout",
  "about": "F5: recording.start is not acked in 5 s: stop is sent, the empty meeting is deleted, start fails with E_TIMEOUT; a late ack for that path is stopped as stale.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "T"
      }
    },
    {
      "op": "advance",
      "ms": 4999
    },
    {
      "op": "snapshot",
      "label": "starting"
    },
    {
      "op": "advance",
      "ms": 1
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "timed-out"
    },
    {
      "op": "call",
      "fn": "dismiss",
      "label": "dismiss"
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "idle|-|-|start-timeout|-|-|ok",
        "idle|-|-|-|-|-|ok"
      ],
      "pipelines": {},
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop",
        "recording.stop"
      ],
      "transcript": [],
      "changed": [
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "start": {
        "err": [
          "E_TIMEOUT",
          "The capture helper did not start recording. Try again."
        ]
      },
      "dismiss": {
        "ok": {
          "phase": "idle",
          "meetingId": null
        }
      }
