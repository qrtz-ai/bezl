{
  "name": "basic-record-stop-done",
  "about": "Happy path: permissions, participants, live transcript with speakers, a live note, stop with ack, finalize (real, stitched WAV, speaker fusion) + summary + index done.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.participants",
        "names": [
          "Ana",
          "Ben"
        ]
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "audio.level",
        "rms": 0.25
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 0,
        "name": "Ana"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "partial",
          "utteranceId": "u1",
          "startMs": 100,
          "text": "hello"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 2000,
        "name": "Ben"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u2",
          "startMs": 2100,
          "endMs": 3900,
          "text": "thanks ana"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "call",
      "fn": "addNote",
      "label": "note",
      "args": {
        "text": "decide on q3"
      }
    },
    {
      "op": "snapshot",
      "label": "recording"
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 4000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "snapshot",
      "label": "done"
    },
    {
      "op": "call",
      "fn": "pipeline",
      "label": "pipe",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "call",
      "fn": "dismiss",
      "label": "dismiss"
    }
  ],
