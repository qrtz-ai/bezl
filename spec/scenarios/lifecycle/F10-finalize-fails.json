{
  "name": "F10-finalize-fails",
  "about": "F10: finalize fails on every attempt (1 s, 2 s backoff): step failed, meeting failed, session error; a manual retry that succeeds brings the session to done.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 0,
        "name": "Ana"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "partial",
          "utteranceId": "u1",
          "startMs": 100,
          "text": "hello"
        }
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u1",
          "startMs": 100,
          "endMs": 1900,
          "text": "hello everyone"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "helper",
      "msg": {
        "type": "ax.activeSpeaker",
        "atMs": 2000,
        "name": "Ben"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "asr",
        "event": {
          "kind": "final",
          "utteranceId": "u2",
          "startMs": 2100,
          "endMs": 3900,
          "text": "thanks ana"
        }
      }
    },
    {
      "op": "advance",
      "ms": 1000
    },
    {
      "op": "steps",
      "finalize": [
        "fail",
        "fail",
        "fail"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "snapshot",
      "label": "first-failure"
    },
    {
      "op": "advance",
      "ms": 800
    },
    {
      "op": "advance",
      "ms": 400
    },
    {
      "op": "advance",
      "ms": 2400
    },
    {
      "op": "snapshot",
      "label": "failed"
    },
    {
      "op": "call",
      "fn": "retryStep",
      "label": "retry",
      "args": {
        "id": "id1",
        "step": "finalize"
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
