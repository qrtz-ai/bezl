{
  "name": "R2-backlog-runs-serially",
  "about": "R2: several unsettled pipelines resume one at a time.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start-a",
      "args": {
        "title": "A"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "steps",
      "finalize": [
        "hang"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop-a"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "call",
      "fn": "dismiss",
      "label": "d1"
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start-b",
      "args": {
        "title": "B"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id2.wav"
      }
    },
    {
      "op": "steps",
      "summary": [
        "hang"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop-b"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id2.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "snapshot",
      "label": "before"
    },
    {
      "op": "restart"
    },
    {
      "op": "snapshot",
      "label": "resumed"
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
