{
  "name": "detect-during-processing",
  "about": "A meeting detected while processing replaces the session's meeting; the pipeline still finishes.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "steps",
      "finalize": [
        "fail"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "meeting.detected",
        "key": "zoom:9",
        "title": "Next",
        "platform": "zoom",
        "app": "zoom.us"
      }
    },
    {
      "op": "snapshot",
      "label": "detected"
    },
    {
      "op": "advance",
      "ms": 1200
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "detected|-|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:retrying/1!E_UNAVAILABLE summary:pending/0 index:pending/0",
          "manual finalize:running/2!E_UNAVAILABLE summary:pending/0 index:pending/0",
          "manual finalize:done/2 summary:pending/0 index:pending/0",
          "manual finalize:done/2 summary:running/1 index:pending/0",
          "manual finalize:done/2 summary:done/1 index:pending/0",
          "manual finalize:done/2 summary:done/1 index:running/1",
          "manual finalize:done/2 summary:done/1 index:done/1"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": [
        "Next|zoom"
      ]
    },
    "results": {
      "start": {
        "ok": {
          "phase": "recording",
          "meetingId": "id1"
        }
      },
      "stop": {
        "ok": {
          "phase": "processing",
          "meetingId": "id1"
        }
      }
    },
    "snapshots": {
      "detected": {
        "view": {
          "phase": "detected",
          "meetingId": null,
          "startedAt": null,
          "elapsedMs": 0,
          "stopReason": null,
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": null
        },
        "live": null,
        "db": {
          "meetings": [
            [
              "id1",
              "Standup",
              "other",
              "recording",
              1760000000000,
              null,
              null,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [],
          "notes": [],
          "pipelines": [
            [
              "id1",
              0,
              "manual",
              "finalize:retrying/1!E_UNAVAILABLE summary:pending/0 index:pending/0",
              4000,
              false,
              [
                "$REC/id1.wav"
              ],
              0
            ]
          ],
          "session": [
            "detected",
            null
          ]
        },
        "files": []
      },
      "end": {
        "view": {
          "phase": "detected",
          "meetingId": null,
          "startedAt": null,
          "elapsedMs": 0,
          "stopReason": null,
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": null
        },
        "live": null,
        "db": {
          "meetings": [
            [
              "id1",
              "Standup",
              "other",
              "done",
              1760000000000,
              1760000000000,
              4000,
              "$REC/id1.wav",
              "general"
            ]
          ],
          "segments": [],
          "summaries": [
            [
              "id1",
              "stub",
              "STUB summary",
              null
            ]
          ],
          "notes": [],
          "pipelines": [
            [
              "id1",
              1,
              "manual",
              "finalize:done/2 summary:done/1 index:done/1",
              4000,
              false,
              [
                "$REC/id1.wav"
              ],
              0
            ]
          ],
          "session": [
            "detected",
            null
          ]
        },
        "files": []
      }
    }
  }
}
