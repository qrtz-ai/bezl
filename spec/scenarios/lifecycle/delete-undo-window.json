{
  "name": "delete-undo-window",
  "about": "Deferred delete (note:delete with deferMs): the tombstone is written at once and the meeting is hidden; undo inside the window restores it and nothing is removed; a second delete runs when its window ends, removes rows and audio, and an undo after that reports too late.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 400,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "call",
      "fn": "scheduleDelete",
      "label": "defer",
      "args": {
        "id": "id1",
        "deferMs": 6000
      }
    },
    {
      "op": "snapshot",
      "label": "tombstoned"
    },
    {
      "op": "advance",
      "ms": 5000
    },
    {
      "op": "call",
      "fn": "undoDelete",
      "label": "undo",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "advance",
      "ms": 5000
    },
    {
      "op": "snapshot",
      "label": "restored"
    },
    {
      "op": "call",
      "fn": "scheduleDelete",
      "label": "defer2",
      "args": {
        "id": "id1",
        "deferMs": 6000
      }
    },
    {
      "op": "advance",
      "ms": 5999
    },
    {
      "op": "snapshot",
      "label": "just-before"
    },
    {
      "op": "advance",
      "ms": 1
    },
    {
      "op": "call",
      "fn": "undoDelete",
      "label": "late-undo",
      "args": {
        "id": "id1"
      }
    }
  ],
  "expect": {
    "trace": {
