{
  "name": "N51-undo-while-delete-runs",
  "about": "N51: an undo that arrives after the window ended, while the deferred delete is still running (slow store), reports too late (false) and the meeting is removed anyway; before the fix it returned true and removed the tombstone while the rows and audio were being deleted. A tombstone from an earlier launch (no timer in this process) is not undoable either and stays for recovery.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 400,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "store",
      "slowMs": {
        "note.delete": 2000
      }
    },
    {
      "op": "call",
      "fn": "scheduleDelete",
      "label": "defer",
      "args": {
        "id": "id1",
        "deferMs": 6000
      }
    },
    {
      "op": "advance",
      "ms": 6000
    },
    {
      "op": "call",
      "fn": "undoDelete",
      "label": "undo-while-deleting",
      "args": {
        "id": "id1"
      }
    },
    {
      "op": "snapshot",
      "label": "deleting"
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "snapshot",
      "label": "after"
    },
    {
      "op": "store",
      "slowMs": {
        "note.delete": 0
      }
    },
    {
      "op": "pendingDelete",
      "id": "id9"
    },
    {
      "op": "call",
      "fn": "undoDelete",
      "label": "undo-earlier-launch",
      "args": {
        "id": "id9"
      }
    },
    {
      "op": "snapshot",
      "label": "earlier-tombstone-kept"
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
