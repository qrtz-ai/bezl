{
  "name": "N39-mic-lost-system-silent",
  "about": "N39: the mic is revoked a minute in, then the other participants go quiet for three minutes. The mic is lost from the revoke to the stop (lost:mic), so the summary reads the quiet stretch as no audio at all instead of a one-sided gap. A device failure in the second part ends at its reconnect, so the working mic after it is not lost. The user grants the mic again before the second meeting.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "helper",
      "msg": {
        "type": "permission.revoked",
        "permission": "microphone",
        "atMs": 60000,
        "degraded": [
          "no-mic"
        ]
      }
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "system",
        "sinceMs": 120000
      }
    },
    {
      "op": "advance",
      "ms": 180000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.audible",
        "source": "system"
      }
    },
    {
      "op": "snapshot",
      "label": "after-quiet"
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "wav",
      "file": "id1.wav",
      "ms": 360000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 360000
      }
    },
    {
      "op": "advance",
      "ms": 100
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start2",
      "args": {
        "title": "Retro"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id2.wav"
      }
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.degraded",
        "degraded": [
          "no-mic"
        ],
        "reason": "device busy"
      }
    },
    {
      "op": "advance",
      "ms": 60000
    },
    {
      "op": "wav",
      "file": "id2.wav",
      "ms": 120000,
      "broken": true
    },
    {
      "op": "helperDown",
      "reason": "exited"
    },
    {
      "op": "advance",
      "ms": 2000
    },
    {
      "op": "helperUp"
    },
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id2.p1.wav"
      }
    },
    {
      "op": "snapshot",
      "label": "restored"
    },
    {
      "op": "helper",
      "msg": {
        "type": "capture.silent",
        "source": "system",
        "sinceMs": 0
      }
    },
    {
      "op": "advance",
      "ms": 120000
    },
    {
      "op": "wav",
      "file": "id2.p1.wav",
      "ms": 120000,
      "broken": false
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop2"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id2.p1.wav",
        "durationMs": 120000
      }
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
