{
  "name": "F14-meeting-deleted-mid-pipeline",
  "about": "F14 (cycle 4: N16): the meeting is deleted behind the host's back (the worker row goes, e.g. another window or the deferred delete of an older build) while the summary waits out its backoff. The next attempt's start save is refused (pipeline.save ok:false), so the host forgets the pipeline: no E_NOT_FOUND attempts, no fallback, nothing written back, and the session lets go of the meeting.",
  "script": [
    {
      "op": "helper",
      "msg": {
        "type": "hello",
        "protocol": 1,
        "helperVersion": "test",
        "os": "macos",
        "features": []
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "permissions.status",
        "status": {
          "accessibility": "granted",
          "screen-recording": "granted",
          "microphone": "granted"
        }
      }
    },
    {
      "op": "call",
      "fn": "start",
      "label": "start",
      "args": {
        "title": "Standup"
      }
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.started",
        "audioPath": "$REC/id1.wav"
      }
    },
    {
      "op": "steps",
      "summary": [
        "fail"
      ]
    },
    {
      "op": "call",
      "fn": "stop",
      "label": "stop"
    },
    {
      "op": "helper",
      "msg": {
        "type": "recording.stopped",
        "audioPath": "$REC/id1.wav",
        "durationMs": 4000
      }
    },
    {
      "op": "db",
      "deleteMeeting": "id1"
    },
    {
      "op": "advance",
      "ms": 2400
    },
    {
      "op": "advance",
      "ms": 100
    }
  ],
  "expect": {
    "trace": {
      "session": [
        "idle|-|-|-|-|-|ok",
        "starting|id1|-|-|-|-|ok",
        "recording|id1|-|-|-|-|ok",
        "stopping|id1|-|-|-|-|ok",
        "processing|id1|-|-|-|-|ok",
        "done|id1|-|-|-|-|ok",
        "idle|-|-|-|-|-|ok"
      ],
      "pipelines": {
        "id1": [
          "manual finalize:pending/0 summary:pending/0 index:pending/0",
          "manual finalize:running/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:pending/0 index:pending/0",
          "manual finalize:done/1 summary:running/1 index:pending/0",
          "manual finalize:done/1 summary:retrying/1!E_UNAVAILABLE index:pending/0",
          "manual finalize:done/1 summary:running/2!E_UNAVAILABLE index:pending/0"
        ]
      },
      "helper": [
        "permissions.check",
        "recording.start $REC/id1.wav",
        "recording.stop"
      ],
      "transcript": [
        [
          0,
          1,
          [],
          null
        ]
      ],
      "changed": [
        "id1",
        "id1",
        "id1"
      ],
      "permissions": [
        "granted|granted|granted"
      ],
      "prompts": []
    },
    "results": {
      "start": {
        "ok": {
          "phase": "recording",
          "meetingId": "id1"
        }
      },
      "stop": {
        "ok": {
          "phase": "processing",
          "meetingId": "id1"
        }
      }
    },
    "snapshots": {
      "end": {
        "view": {
          "phase": "idle",
          "meetingId": null,
          "startedAt": null,
          "elapsedMs": 0,
          "stopReason": null,
          "degraded": [],
          "error": null,
          "paused": false,
          "progress": null,
          "reconnect": null,
          "helper": "ok",
          "participants": [],
          "activeSpeaker": null,
          "lines": [],
          "partial": "",
          "pipeline": null
        },
        "live": null,
        "db": {
          "meetings": [],
          "segments": [],
          "summaries": [],
          "notes": [],
          "pipelines": [],
          "session": [
            "idle",
            null
          ]
        },
        "files": []
      }
    }
  }
}
